# Server secrets: never upload your real .env to GitHub.
BOT_TOKEN=
# Telegram user ID of Busenka. /id in your bot returns the sender's ID.
# Leave empty ONLY for initial bot setup: gifts remain inaccessible.
ALLOWED_TELEGRAM_ID=
APP_URL=https://your-app.example.com
DATABASE_PATH=./data/gifts.sqlite
PORT=3000
HOST=0.0.0.0
TIMEZONE=Europe/Moscow
REMINDER_HOUR=10
REMINDER_MINUTE=0
AUTH_MAX_AGE_SECONDS=3600
# Optional: your private chat ID for copies of result notifications.
ADMIN_CHAT_ID=
